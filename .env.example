# Expo Environment Variables
# DİKKAT: Expo istemci tarafında (React Native / Web) okunacak değişkenler "EXPO_PUBLIC_" ile başlamalıdır.

# ========================================================
# 1. YAPAY ZEKA MODELİ (GOOGLE GEMINI / NANO BANANA PRO)
# ========================================================
# Google AI Studio'dan (https://aistudio.google.com/) aldığınız API anahtarı:
EXPO_PUBLIC_GEMINI_API_KEY=

# Nano Banana Pro (Gemini 3 Pro Image) Modeli
EXPO_PUBLIC_GEMINI_IMAGE_MODEL=gemini-3-pro-image

# ========================================================
# 2. STRIPE ÖDEME ALTYAPISI (İSTEMCİ / CLIENT TARAFI)
# ========================================================
# Stripe İstemci Yayınlanabilir Anahtarı (Publishable Key):
# Stripe Dashboard -> Developers -> API keys (pk_test_... veya pk_live_...)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sample

# Stripe Apple Pay Merchant ID (iOS için Apple Developer Merchant tanımlayıcısı):
EXPO_PUBLIC_STRIPE_MERCHANT_IDENTIFIER=merchant.com.lumieresucree.app

# Stripe Varsayılan Para Birimi (try, usd, eur)
EXPO_PUBLIC_STRIPE_CURRENCY=try

# Ödeme Sunucusu API Uç Noktası (PaymentIntent oluşturan backend URL'i):
# Örneğin: https://api.lumieresucree.app/api/create-payment-intent veya http://localhost:3000/api
EXPO_PUBLIC_PAYMENT_BACKEND_URL=

# ========================================================
# 3. SUNUCU TARAFI STRIPE GİZLİ ANAHTARLARI (BACKEND ONLY)
# DİKKAT: Bu gizli anahtarlar asla istemci tarafına maruz bırakılmamalıdır!
# ========================================================
# Stripe Gizli Anahtarı (Secret Key): sk_test_... veya sk_live_...
STRIPE_SECRET_KEY=sk_test_sample

# Stripe Webhook İmzası (Webhook Secret): whsec_...
STRIPE_WEBHOOK_SECRET=whsec_sample
