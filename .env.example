# Expo Environment Variables
# DİKKAT: Expo istemci tarafında (React Native / Web) okunacak değişkenler "EXPO_PUBLIC_" ile başlamalıdır.

# ========================================================
# 1. YAPAY ZEKA MODELİ (GOOGLE GEMINI / NANO BANANA 2.1)
# ========================================================
# Google AI Studio'dan (https://aistudio.google.com/apikey) aldığınız API anahtarı:
EXPO_PUBLIC_GEMINI_API_KEY=

# Görsel Üretim Modeli
# Seçenekler:
# - gemini-3.1-flash-image (Önerilen: Gemini 3.1 Flash Image motoru)
# - gemini-nano-banana-2.1 (Gemini Nano Banana 2.1 fotoğraf motoru)
# - gemini-3-pro-image     (Nano Banana Pro)
EXPO_PUBLIC_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ========================================================
# GEMINI 3.1 FLASH LITE TARİF MOTORU (Kendi Pastanı Oluştur)
# ========================================================
# Kendi Pastanı Oluştur ekranında fotoğrafın altına fırın derecesi,
# kaç yumurta konacağı, kremanın nasıl yapılacağı ve adım adım yapılış
# rehberini üreten Gemini 3.1 Flash Lite modeli:
EXPO_PUBLIC_GEMINI_RECIPE_MODEL=gemini-3.1-flash-lite

# Maksimum Token Sınırı (Fotoğraftaki pastanın birebir aynısını yapabilmek için 10.000 token'a kadar detaylı rehber)
EXPO_PUBLIC_GEMINI_RECIPE_MAX_TOKENS=10000

# Varsayılan Fotoğraf Kalitesi ('4k' veya 'standard')
# '4k': 4K ultra yüksek çözünürlüklü stüdyo fotoğrafı (imageSize: '4K')
# 'standard': 2K yüksek çözünürlüklü fotoğraf (imageSize: '2K')
EXPO_PUBLIC_AI_DEFAULT_QUALITY=4k
# GÜVENLİ BACKEND PROXY (PRODÜKSİYON / CANLI MOBİL UYGULAMA İÇİN ŞARTTIR):
# Mobil derlemede Gemini API anahtarının tersine mühendislikle çalınmasını önler.
# Örnek: https://api.lumieresucree.app veya Cloudflare Worker URL'iniz
EXPO_PUBLIC_AI_BACKEND_URL=

# ========================================================
# 2. REVENUECAT IN-APP PURCHASES (APPLE STOREKIT & GOOGLE PLAY)
# DİKKAT: Apple App Store ve Google Play dijital kredi/ürün satışında zorunludur!
# Stripe gibi harici web ödemeleri Apple tarafından dijital içerikte yasaklanmıştır.
# ========================================================
# RevenueCat Dashboard -> Project Settings -> API Keys -> Public app-specific API keys
# Apple App Store için Public API Anahtarı (appl_... formatında):
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_your_revenuecat_apple_key

# Google Play Store için Public API Anahtarı (goog_... formatında):
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_your_revenuecat_google_key

