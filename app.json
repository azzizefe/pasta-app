{
  "expo": {
    "name": "Lumière Sucrée",
    "slug": "lumiere-sucree",
    "scheme": "lumieresucree",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF6F0",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lumieresucree.app",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Lumière Sucrée, pasta tasarımlarınıza ilham vermesi için davetiye veya konsept fotoğraflarını seçmenize olanak tanır.",
        "NSPhotoLibraryAddUsageDescription": "Oluşturduğunuz şaheser pasta tasarımlarını fotoğraf galerinize yüksek çözünürlükte kaydetmek için izin gereklidir.",
        "NSCameraUsageDescription": "Özel gününüz için ilham aldığınız detayların anlık fotoğrafını çekerek pasta tasarımına dönüştürmenizi sağlar.",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.lumieresucree.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAF6F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "locales": {
      "tr": "./locales/tr.json",
      "en": "./locales/en.json",
      "fr": "./locales/fr.json",
      "ar": "./locales/ar.json",
      "de": "./locales/de.json",
      "es": "./locales/es.json",
      "it": "./locales/it.json",
      "pt": "./locales/pt.json",
      "ru": "./locales/ru.json",
      "uk": "./locales/uk.json",
      "pl": "./locales/pl.json",
      "nl": "./locales/nl.json",
      "ja": "./locales/ja.json",
      "ko": "./locales/ko.json",
      "zh-Hans": "./locales/zh-Hans.json",
      "id": "./locales/id.json"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-image",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Lumière Sucrée, pasta tasarımlarınıza ilham vermesi için davetiye veya konsept fotoğraflarını seçmenize olanak tanır.",
          "savePhotosPermission": "Oluşturduğunuz şaheser pasta tasarımlarını fotoğraf galerinize yüksek çözünürlükte kaydetmek için izin gereklidir.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-apple-authentication",
      "@sentry/react-native",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "tr",
            "en",
            "fr",
            "ar",
            "de",
            "es",
            "it",
            "pt",
            "ru",
            "uk",
            "pl",
            "nl",
            "ja",
            "ko",
            "zh-Hans",
            "id"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF6F0"
        }
      ],
      "expo-web-browser"
    ]
  }
}
