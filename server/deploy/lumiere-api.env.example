# Sunucuda /etc/lumiere-api.env olarak kaydet (chmod 600). Bu dosyayı asla git'e koyma.
GEMINI_API_KEY=buraya-yeni-gemini-anahtari
# Modeller (isteğe bağlı; yazmazsan bunlar kullanılır). Değiştirince: systemctl restart lumiere-api
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_RECIPE_MODEL=gemini-3.1-flash-lite
GEMINI_RECIPE_MAX_TOKENS=10000
# Satın alınan kredileri tanımlamak için (RevenueCat webhook). Üçü birlikte gerekli:
# REVENUECAT_WEBHOOK_SECRET=
# SUPABASE_URL=https://supabase-adresin
# SUPABASE_SERVICE_ROLE_KEY=   (service_role anahtarı; uygulamaya asla koyma)
# İsteğe bağlı:
# OPENAI_API_KEY=
